---
import dayjs from "dayjs";

interface Props {
  pubDate: Date;
  tags: string[];
}

const { pubDate, tags } = Astro.props;
---

<p class="noteMeta">
  <time class="noteDate" datetime={dayjs(pubDate).format("MM/D/YYYY")}>
    Published: {dayjs(pubDate).format("MM/D/YYYY")}</time
  >
  <span class="noteTags">Tags: {tags.join(", ")}</span>
</p>
