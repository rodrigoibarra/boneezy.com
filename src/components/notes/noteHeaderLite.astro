---
import NoteTitle from "@components/notes/noteTitle.astro";
import NoteDescription from "@components/notes/noteDescription.astro";
interface Props {
  title: string;
  pubDate: Date;
  tags: string;
  description: string;
  id: string;
}

const { title, description, id } = Astro.props;
---

<div class="cover stack noteHeader">
  <NoteTitle title={title} />
  <NoteDescription description={description} />
  <a href={`/notes/${id}/`} class="postLink">Read the thing.</a>
</div>

<style>
  .noteHeader {
    min-block-size: 20vh;
  }
  .postLink {
    font-size: var(--step-1);
  }
  .cover {
    display: flex;
    flex-direction: column;
    padding: 0;
  }

  .cover > * {
    margin-block: 1rem;
  }

  .cover > :first-child:not(h1) {
    margin-block-start: 0;
  }

  .cover > :last-child:not(h1) {
    margin-block-end: 0;
  }

  .cover > h1 {
    margin-block: auto;
  }
</style>
