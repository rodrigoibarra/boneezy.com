---
import NoteHeaderLite from "@components/notes/noteHeaderLite.astro";
import { getPosts } from "@lib/ghost";

const posts = await getPosts();
const note = posts[0];
const { title, pubDate, tags, description } = note.data;
const id = note.id;
---

<article class="general-container">
  <div class="note-header-home">
    <NoteHeaderLite
      title={title}
      pubDate={pubDate}
      tags={tags}
      description={description}
      id={id}
    />
  </div>
</article>
