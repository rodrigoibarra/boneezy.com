---
import { getCollection, render } from "astro:content";
import NoteHeaderLite from "@components/notes/noteHeaderLite.astro";

const allNotes = await getCollection("notes");
const sortedPosts = allNotes.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const note = sortedPosts[0];
const { title, pubDate, tags, description } = note.data;
const id = note.id;
console.log(note.id);
---

<article class="general-container">
  <div class="note-header-home">
    <NoteHeaderLite
      title={title}
      pubDate={pubDate}
      tags={tags}
      description={description}
      id={id}
    />
  </div>
</article>
