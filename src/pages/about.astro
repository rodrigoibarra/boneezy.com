---
import BaseLayer from "@layouts/BaseLayer.astro";
---

<BaseLayer>
  <main>
    <section class="masthead cover">
      <h1 class="fancyLettering">About Me</h1>
    </section>
    <section class="generalContainer">
      <div class="stack generalGrid noteBody">
        <p>
          Hey! I'm Rodrigo Ibarra, web designer, amateur cook, and home barista
          based in Mexico City. I make awesome coffee and pretty good websites.
        </p>
        <p>
          When I'm not designing or coding I'm usually digging into specialty
          coffee — particularly Mexican origin. I take my home setup a little
          too seriously.
        </p>
        <p>
          I also enjoy tinkering with self-hosted infrastructure, homelabbing,
          and occasionally yelling at my local sports teams.
        </p>

        <section class="aboutLinks">
          <h2>Links</h2>
          <ul>
            <li>
              <a
                href="https://www.instagram.com/killerbunnz/"
                target="_blank"
                rel="noopener noreferrer">Instagram</a
              > | killerbunnz
            </li>
            <li>
              <a
                href="https://github.com/rodrigoibarra"
                target="_blank"
                rel="noopener noreferrer">GitHub</a
              > | rodrigoibarra
            </li>
            <li>
              <a
                href="https://x.com/_rodrigoibarra"
                target="_blank"
                rel="noopener noreferrer">X</a
              > | @_rodrigoibarra
            </li>
          </ul>
        </section>

        <section class="aboutColophon">
          <h2>Colophon</h2>
          <p>
            This site is built with <a
              href="https://astro.build"
              target="_blank"
              rel="noopener noreferrer">Astro</a
            > and hosted on <a
              href="https://netlify.com"
              target="_blank"
              rel="noopener noreferrer">Netlify</a
            >.
          </p>
          <p>
            Typeset in <a
              href="https://simplebits.shop/products/vault-alarm"
              target="_blank"
              rel="noopener noreferrer">Vault Alarm</a
            > for headings, <a
              href="https://djr.com/fern"
              target="_blank"
              rel="noopener noreferrer">Fern</a
            > for body text, and <a
              href="https://simplebits.shop/products/captain-edward"
              target="_blank"
              rel="noopener noreferrer">Captain Edward</a
            > for accents — Vault Alarm and Captain Edward by Dan Cederholm, Fern
            by David Jonathan Ross.
          </p>
        </section>
      </div>
    </section>
  </main>
</BaseLayer>
