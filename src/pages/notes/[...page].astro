---
import BaseLayer from "@layouts/BaseLayer.astro";
import { getPosts } from "@lib/ghost";

export async function getStaticPaths({ paginate }) {
  const notes = await getPosts();
  return paginate(notes, {
    pageSize: 15,
  });
}

const { page } = Astro.props;
---

<BaseLayer>
  <main class="stack">
    <section class="masthead cover">
      <h1 class="fancyLettering">The Notes</h1>
    </section>
    <section class="generalContainer">
      <div class="generalGrid">
        <ol class="noteList stack">
          {
            page.data.map((post, index) => {
              const number = page.total - (page.start + index);
              return (
                <li>
                  <a href={`/notes/${post.id}/`}>
                    {" "}
                    <span class="noteNumber"> #{number}</span> {post.data.title}
                  </a>
                  <p>| {post.data.description}</p>{" "}
                  <span class="note-tags">
                    {" "}
                    {post.data.tags.join(", ")}
                  </span>{" "}
                </li>
              );
            })
          }
        </ol>
      </div>
      <nav class="pagination">
        {page.url.prev && <a href={page.url.prev}>← Previous</a>}
        <span>{page.currentPage} / {page.lastPage}</span>
        {page.url.next && <a href={page.url.next}>Next →</a>}
      </nav>
    </section>
  </main>
</BaseLayer>
